# Keep repository text bytes consistent across Windows and Linux checkouts.
* text=auto eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.webmanifest text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.pdf -text
